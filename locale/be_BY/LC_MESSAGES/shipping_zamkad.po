msgid "Загрузка настроек"
msgstr "Загрузка налад"

msgid "Дополнительные выходные"
msgstr "Дадатковыя выхадныя"

msgid "Дополнительные рабочие дни"
msgstr "Дадатковыя працоўныя дні"

msgid "Регион доставки"
msgstr "Рэгіён дастаўкі"

msgid "Дата доставки"
msgstr "Дата дастаўкі"

msgid "Расстояние"
msgstr "Адлегласць"

msgid "Фикс. цена"
msgstr "Фікс. цана"

msgid "Цена за 1 км."
msgstr "Цана за 1 км."

msgid "Добавить тариф"
msgstr "Дадаць тарыф"

msgid "Запрашивать желаемую дату доставки"
msgstr "Запытаць жаданую дату дастаўкі"

msgid "Запрашивать желаемый интервал доставки"
msgstr "Запытаць жаданы інтэрвал дастаўкі"

msgid "Поля даты и интервала доставки"
msgstr "Поля даты і інтэрвалу дастаўкі"

msgid "Показывать ориентировочную дату доставки"
msgstr "Паказваць арыентыровачны дату дастаўкі"

msgid "Укажите количество дней на доставку. Число или диапазон через тире. Например «1» — один день, т.е. доставка на следующий день, «1-2» — один или два дня, т.е. завтра-послезавтра"
msgstr "Пакажыце колькасць дзен на дастаўку. Лік або дыяпазон праз працяжнік. Напрыклад «1» — адзін дзень, г. зн. дастаўка на наступны дзень, «1-2» - адзін ці два дні, г. зн. заўтра-паслязаўтра"

msgid "Название поля с расстоянием"
msgstr "Назва поля з адлегласцю"

msgid "Расстояние от города (км.)"
msgstr "Адлегласць ад горада (км.)"

msgid "Доставка будет ограничена только выбранной страной или регионом страны"
msgstr "Дастаўка будзе абмежаваная толькі абранай краінай або рэгіёнам краіны"

msgid "Ограничения по географии"
msgstr "Абмежаванні па геаграфіі"

msgid "Ограничение по стоимости заказа"
msgstr "Абмежаванне па кошту замовы"

msgid "Ограничение по весу"
msgstr "Абмежаванне па вазе"

