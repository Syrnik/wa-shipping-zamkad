msgid "Загрузка настроек"
msgstr "Параметрлерді жүктеу"

msgid "Дополнительные выходные"
msgstr "Қосымша демалыс күндері"

msgid "Дополнительные рабочие дни"
msgstr "Қосымша жұмыс күндері"

msgid "Регион доставки"
msgstr "Жеткізу аймағы"

msgid "Дата доставки"
msgstr "Жеткізу күні"

msgid "Расстояние"
msgstr "Қашықтық"

msgid "Фикс. цена"
msgstr "Белг. баға"

msgid "Цена за 1 км."
msgstr "1 км бағасы."

msgid "Добавить тариф"
msgstr "Тарифті қосыңыз"

msgid "Запрашивать желаемую дату доставки"
msgstr "Қажетті жеткізу күнін сұраңыз"

msgid "Запрашивать желаемый интервал доставки"
msgstr "Қажетті жеткізу аралығын сұраңыз"

msgid "Поля даты и интервала доставки"
msgstr "Жеткізу күні мен аралығы өрістері"

msgid "Показывать ориентировочную дату доставки"
msgstr "Жеткізудің болжамды күнін көрсетіңіз"

msgid "Укажите количество дней на доставку. Число или диапазон через тире. Например «1» — один день, т.е. доставка на следующий день, «1-2» — один или два дня, т.е. завтра-послезавтра"
msgstr "Жеткізу күндерінің санын көрсетіңіз. Сызықша арқылы сан немесе диапазон. Мысалы, \"1\" - бір күн, яғни келесі күні жеткізу, \"1-2\" — бір немесе екі күн, яғни ертең-ертеңнен кейін"

msgid "Название поля с расстоянием"
msgstr "Қашықтық өрісінің атауы"

msgid "Расстояние от города (км.)"
msgstr "Қаладан қашықтық (км.)"

msgid "Доставка будет ограничена только выбранной страной или регионом страны"
msgstr "Жеткізу тек таңдалған елмен немесе елдің аймағымен шектеледі"

msgid "Ограничения по географии"
msgstr "География бойынша шектеулер"

msgid "Ограничение по стоимости заказа"
msgstr "Тапсырыс құны бойынша шектеу"

msgid "Ограничение по весу"
msgstr "Салмақ шегі"

msgid "от"
msgstr "бастап"

msgid "до"
msgstr "дейін"

msgid "Поле адреса «Улица, дом, квартира»"
msgstr "Мекенжай өрісі \"көше, үй, пәтер\""

msgid "не запрашивать"
msgstr "сұрамаңыз"

msgid "запрашивать"
msgstr "сұрау"

msgid "требовать"
msgstr "талап ету"

